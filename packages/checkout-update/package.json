    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@polyth/contracts": "1.2.0",
    "@polyth/kernel": "0.1.0",
    "@polyth/plugins": "0.1.0"
  }

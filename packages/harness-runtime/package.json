    "./installers": "./src/installers.ts",
    "./native-plugins": "./src/nativePlugins.ts",
    "./native-skills": "./src/nativeSkills.ts",
    "./process-authority": "./src/processAuthority.ts",
    "./remote-host": "./src/remoteHost.ts",

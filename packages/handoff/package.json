{
  "name": "@polyth/handoff",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./widgets/lib/index.ts",
    "./i18n": "./widgets/i18n/index.ts",
    "./i18n/*": "./widgets/i18n/*.ts"
  },
  "polyth": {
    "serverEntry": "./src/serverEntry.ts",
    "webEntry": "./widgets/index.tsx",
    "descriptor": {
      "name": "Handoff",
      "description": "Build context bundles and import chat results into Polyth sessions.",
      "core": false,
      "enabled": true,
      "settingsGroup": "Workspace",
      "icon": "⇄",
      "hasSettings": false
    }
  },
  "dependencies": {
    "@polyth/contracts": "0.1.0",
    "@polyth/plugins": "0.1.0",
    "@polyth/session": "0.1.0",
    "@polyth/web-sdk": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

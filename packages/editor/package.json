{
  "name": "@polyth/editor",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./intelligence": "./widgets/intelligence.ts",
    "./i18n": "./src/i18n/index.ts",
    "./widgets": "./widgets/index.tsx",
    "./i18n/*": "./src/i18n/*.ts"
  },
  "polyth": {
    "serverEntry": "./src/serverEntry.ts",
    "webEntry": "./widgets/index.tsx",
    "descriptor": {
      "name": "Editor",
      "description": "Text and code editing runtime for the workbench.",
      "core": true,
      "enabled": true,
      "icon": "edit",
      "hasSettings": false,
      "category": "engineering",
      "projectAffinity": {
        "directions": [
          "engineering",
          "research"
        ],
        "recommended": true
      }
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@polyth/contracts": "1.2.0",
    "@polyth/plugins": "0.1.0",
    "@polyth/web-sdk": "0.1.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

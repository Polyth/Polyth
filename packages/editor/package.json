{
  "name": "@polyth/editor",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./widgets": "./widgets/index.tsx",
    "./i18n/*": "./src/i18n/*.ts"
  },
  "polyth": {

{
  "name": "@polyth/model-privacy",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/resolvePolicy.ts",
    "./widgets": "./widgets/index.tsx"
  },
  "polyth": {
    "editions": [
      "workstation"
    ],
    "serverEntry": "./src/serverEntry.ts",
    "webEntry": "./widgets/index.tsx",
    "descriptor": {
      "name": "Model privacy",
      "description": "Marks beside model names that say whether a free model's provider keeps your prompts or trains on them, with the source and the date it was checked.",
      "core": false,
      "enabled": true,
      "settingsGroup": "Engineering",
      "icon": "shield",
      "hasSettings": true,
      "category": "engineering",
      "projectAffinity": {}
    }
  },
  "dependencies": {
    "@polyth/contracts": "1.2.0",
    "@polyth/models": "0.1.0",
    "@polyth/plugins": "0.1.0",
    "@polyth/web": "0.1.0",
    "@polyth/web-sdk": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

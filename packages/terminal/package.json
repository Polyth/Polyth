{
  "name": "@polyth/terminal",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./project-tools": "./src/projectTools.ts",
    "./tool-types": "./src/projectToolTypes.ts",
    "./tool-ui": "./widgets/tools.tsx",
    "./i18n": "./src/i18n/index.ts",
    "./widgets": "./widgets/index.tsx",

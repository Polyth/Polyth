      "enabled": true,
      "settingsGroup": "Workspace",
      "icon": "hierarchy",
      "hasSettings": true,
      "category": "workspace",
      "projectAffinity": {}
    }
  },
  "dependencies": {
    "@polyth/contracts": "1.2.0",
    "@polyth/plugins": "0.1.0",
    "@polyth/web-sdk": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

{
  "name": "@polyth/hotkeys",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./widgets": "./widgets/hotkeys.ts",
    "./i18n/*": "./src/i18n/*.ts"
  },
  "polyth": {
    "serverEntry": "./src/serverEntry.ts",
    "webEntry": "./widgets/index.tsx",
    "descriptor": {

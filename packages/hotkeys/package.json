      "settingsGroup": "Workspace",
      "icon": "keyboard",
      "hasSettings": true
    }
  },
  "dependencies": {
    "@polyth/plugins": "0.1.0",
    "@polyth/web-sdk": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

{
  "name": "@polyth/models",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./model-picker": "./widgets/ModelPicker.tsx",
    "./model-picker-state": "./widgets/modelPickerState.ts",
    "./model-presentation": "./widgets/modelPresentation.ts",
    "./web-prefs": "./widgets/modelPrefs.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/well-known": "./src/auth/wellKnown.ts",
    "./widgets": "./widgets/index.tsx",

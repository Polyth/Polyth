{
  "name": "@polyth/usage",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./analytics": "./src/analytics/contracts.ts",
    "./cache-ttl": "./src/analytics/cacheHealth.ts",
    "./session-cache": "./src/analytics/sessionCache.ts",
    "./widgets": "./widgets/index.tsx",
    "./i18n/*": "./src/i18n/*.ts"
  },
  "polyth": {
    "serverEntry": "./src/serverEntry.ts",

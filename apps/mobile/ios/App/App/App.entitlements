<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's own group stays first so existing Keychain items keep their
	     default group; the second is shared with the Notification Service Extension. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.polyth.mobile</string>
		<string>$(AppIdentifierPrefix)com.polyth.mobile.push-content</string>
	</array>
	<!-- Set per signing configuration; release builds must supply their own
	     development/production value and never inherit a hard-coded default. -->
	<key>aps-environment</key>
	<string>$(POLYTH_APS_ENVIRONMENT)</string>
</dict>
</plist>

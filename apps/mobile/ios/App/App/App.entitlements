<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Set per signing configuration; release builds must supply their own
	     development/production value and never inherit a hard-coded default. -->
	<key>aps-environment</key>
	<string>$(POLYTH_APS_ENVIRONMENT)</string>
</dict>
</plist>

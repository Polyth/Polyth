<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read-only use: the words a pushed update cannot carry, which the App
	     writes for this widget (PolythLiveActivityStore). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.polyth.mobile.live-activity</string>
	</array>
</dict>
</plist>

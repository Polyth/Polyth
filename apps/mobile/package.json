{
  "name": "@polyth/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polyth Capacitor client for an existing Polyth runtime",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/ConnectionScreen.tsx",
    "./native": "./src/nativeBridge.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "sync": "cap sync && node scripts/configure-ios-polyth-link.mjs",
    "copy": "cap copy",
    "native:ios": "bash scripts/build-polyth-link-ios.sh",
    "open:android": "cap open android",
    "open:ios": "npm run native:ios && cap open ios",
    "build:android": "cap build android",
    "build:ios": "npm run native:ios && cap build ios",
    "assets": "capacitor-assets generate --android && capacitor-assets generate --ios"
  },
  "dependencies": {
    "@polyth/pairing-qr": "0.1.0",
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capawesome/capacitor-file-picker": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0"
  }
}

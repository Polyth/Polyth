{
  "name": "@polyth/mobile",
  "version": "1.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Polyth Capacitor client for an existing Polyth runtime",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/ConnectionScreen.tsx",
    "./connection-controller": "./src/connectionController.ts",
    "./connection-ui": "./src/connectionUi.ts",
    "./link": "./src/polythLink.ts",
    "./launch": "./src/launch.ts",
    "./native": "./src/nativeBridge.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "sync": "node ../../tools/release/node_modules/@capacitor/cli/bin/capacitor sync && node scripts/configure-ios-polyth-link.mjs && node scripts/bundle-package-assets.mjs",
    "copy": "node ../../tools/release/node_modules/@capacitor/cli/bin/capacitor copy && node scripts/bundle-package-assets.mjs",
    "native:ios": "bash scripts/build-polyth-link-ios.sh",
    "open:android": "node ../../tools/release/node_modules/@capacitor/cli/bin/capacitor open android",
    "open:ios": "npm run native:ios && node ../../tools/release/node_modules/@capacitor/cli/bin/capacitor open ios",
    "build:android": "node ../../tools/release/node_modules/@capacitor/cli/bin/capacitor build android",
    "build:ios": "npm run native:ios && node ../../tools/release/node_modules/@capacitor/cli/bin/capacitor build ios",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.0",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@polyth/pairing-qr": "0.1.0"
  }
}

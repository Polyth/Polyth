{
  "version": 3,
  "rules": [
    {
      "id": "question-sse-blackhole",
      "method": "GET",
      "pathPattern": "^/event(?:\\?|$)",
      "action": {
        "kind": "blackhole"
      }
    },
    {
      "id": "question-pending-empty",
      "method": "GET",
      "pathPattern": "^/question(?:\\?|$)",
      "action": {
        "kind": "synthetic",
        "status": 200,
        "body": []
      }
    },
    {
      "id": "question-answer-drop",
      "method": "POST",
      "pathPattern": "/question/que_046cf6189001JJz3dHxUZbLkeu/(?:reply|reject)(?:\\?|$)",
      "bodyIncludes": "\"blue\"",
      "maxUses": 1,
      "action": {
        "kind": "drop-before-headers",
        "delayMs": 2
      }
    }
  ]
}
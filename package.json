{
  "name": "polyth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "preinstall": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "build:web": "node apps/web/build.ts",
    "build": "npm run build:web",
    "prestart": "node scripts/check-node.mjs",
    "start": "node packages/server/src/index.ts",
    "predev": "node scripts/check-node.mjs",
    "dev": "npm run build:web && node packages/server/src/index.ts",
    "pretest": "node scripts/check-node.mjs",
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.24.0",
    "happy-dom": "^20.11.6",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "mermaid": "^11.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  }
}

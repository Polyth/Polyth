# Copy to .env next to the compose files. Every value is optional unless noted.

# Image to run; leave unset to build locally as polyth:local.
# POLYTH_IMAGE=ghcr.io/<owner>/polyth:latest
# Build target: polyth (default) or polyth-browser (adds Chromium).
# POLYTH_TARGET=polyth
# Build-time user id/group id; match the owner of POLYTH_WORKSPACE (`id -u`, `id -g`).
# POLYTH_UID=1000
# POLYTH_GID=1000
# host (default) builds the Polyth Link host; none omits it.
# POLYTH_LINK=host

# Host folder mounted at /workspace; open projects from there.
# POLYTH_WORKSPACE=./workspace

# compose.yml (host network) only.
# POLYTH_PORT=4400

# compose.proxy.yml only.
# Required: public DNS name of this host.
# POLYTH_DOMAIN=polyth.example.com
# "tls internal" for a host without public DNS/ACME, or "tls you@example.com".
# POLYTH_TLS=
# Browsers must reach Polyth on 443: the origin is https://$POLYTH_DOMAIN.
# POLYTH_HTTP_PORT=80
# POLYTH_HTTPS_PORT=443
# Loopback port of the first-run polyth-setup service (profile "setup").
# POLYTH_SETUP_PORT=4400
# Private network for the proxy hop; change if it overlaps an existing network.
# POLYTH_SUBNET=172.29.84.0/24
# POLYTH_PROXY_IP=172.29.84.2
# POLYTH_APP_IP=172.29.84.3

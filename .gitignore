play-console-service-account.json
*service-account*.json
# Per-developer Firebase app configuration (the build works without them)
google-services.json
GoogleService-Info.plist

# Local environment files; templates such as deploy/docker/.env.example stay tracked
.env
.env.*
!.env.example
.npmrc
.netrc

# External builder and release script outputs (scripts/ci/remote-build.mjs)
/remote-build-output/
/.remote-build-tmp/

# Tool caches, coverage and logs
coverage/
*.tsbuildinfo
*.log
npm-debug.log*

# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Build-time staged controlled browser binaries
/apps/desktop/resources/chromium/

# Native branding outputs are generated from apps/mobile/resources/*.svg.
# Keep only the source-of-truth artwork in Git; npm run assets recreates these.
/apps/mobile/icons/
/apps/mobile/android/app/src/main/res/mipmap-*/ic_launcher*
/apps/mobile/android/app/src/main/res/drawable*/splash.png
/apps/mobile/android/app/src/main/res/drawable*/polyth_launch_*.png
/apps/mobile/android/app/src/main/res/drawable/ic_launcher_background.xml
/apps/mobile/android/app/src/main/res/drawable-v24/ic_launcher_foreground.xml
/apps/mobile/android/app/src/main/res/values/ic_launcher_background.xml
/apps/mobile/ios/App/App/Assets.xcassets/AppIcon.appiconset/*.png
/apps/mobile/ios/App/App/Assets.xcassets/Splash.imageset/*.png


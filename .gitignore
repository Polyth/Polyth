# Creative Studio deliverables when the studio runs on this checkout
/final/
/report.md
/report-*.md
*.polyth-tmp.*
/scripts/backup.sh
# Data-dir runtime state that has historically been written at the repo root
# when POLYTH_DATA_DIR was unset or pointed at cwd. Canonical location is ./data.
/mcp.json
/mcp-secrets.json
/packages.json
/model-visibility.json
/quotas.json
/forbidden-config.json
